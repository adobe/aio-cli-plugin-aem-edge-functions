{
  "name": "@adobe/aio-cli-plugin-aem-edge-functions",
  "description": "Adobe I/O CLI plugin for interacting with AEM Edge Functions",
  "version": "1.1.0",
  "author": "Adobe Inc.",
  "engines": {
    "npm": ">= 8.0.0",
    "node": "^20.19.0 || >=22.15 <23 || >=24.10 <25"
  },
  "dependencies": {
    "@adobe/aio-lib-console": "5.8.0",
    "@adobe/aio-lib-core-config": "5.0.1",
    "@adobe/aio-lib-core-networking": "5.1.0",
    "@adobe/aio-lib-ims": "8.1.2",
    "@fastly/cli": "17.0.0",
    "@inquirer/prompts": "8.7.4",
    "@oclif/core": "4.14.0",
    "chalk": "5.6.2",
    "jsonwebtoken": "9.0.3",
    "open": "11.0.4",
    "ora-classic": "5.4.2"
  },
  "devDependencies": {
    "@adobe/eslint-config-aio-lib-config": "5.0.0",
    "@inquirer/testing": "3.3.15",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "9.1.7",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "prettier": "3.9.10",
    "sinon": "22.1.0"
  },
  "bin": {
    "adobe-aem-edge-functions-cli": "bin/run"
  },
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aio-cli-plugin-aem-edge-functions.git"
  },
  "scripts": {
    "test": "nyc --all --exclude 'eslint_rules/*' --exclude 'eslint.config.js' --exclude 'coverage/*' --exclude 'src/index.js' --exclude 'test/*' --reporter=text --reporter=html mocha 'test/**/*.test.js'",
    "prepare": "husky",
    "lint": "eslint --fix --ext .js",
    "lint-all": "eslint --fix --ext .js,.jsx .",
    "format": "npx prettier --write '**/*.(js|jsx|yaml|md|json)' --no-error-on-unmatched-pattern"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "npm run format"
    ],
    "*.{yaml,sh,json}": [
      "npm run format"
    ]
  },
  "files": [
    "/src",
    "/bin/run"
  ],
  "keywords": [
    "oclif-plugin"
  ],
  "license": "Apache-2.0",
  "overrides": {
    "uuid": "^14.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  },
  "oclif": {
    "commands": "./src/commands",
    "bin": "aio",
    "topics": {
      "aem:edge-functions": {
        "description": "Interact with AEM Edge Functions."
      }
    }
  }
}
